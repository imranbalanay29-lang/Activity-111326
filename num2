#include <iostream>
#include <sstream>
#include <string>

using namespace std;

long long factorial(int n) {
    if (n == 0) {
        return 1;
    }
    return n * factorial(n - 1);
}

long long sumNatural(int n) {
    if (n == 0) {
        return 0;
    }
    return n + sumNatural(n - 1);
}

long long sumSquares(int n) {
    if (n == 0) {
        return 0;
    }
    return 1LL * n * n + sumSquares(n - 1);
}

void compareResults(int n) {
    const long long fact = factorial(n);
    const long long sum = sumNatural(n);

    if (fact > sum) {
        cout << "Factorial greater (" << fact << " > " << sum << ")\n";
    } else if (sum > fact) {
        cout << "Sum greater (" << sum << " > " << fact << ")\n";
    } else {
        cout << "Equal (" << fact << " = " << sum << ")\n";
    }
}
bool readIntegerInRange(const string& prompt, int minimum, int maximum,
                        const string& errorMessage, int& result) {
    string line;

    while (true) {
        cout << prompt << flush;
        if (!getline(cin, line)) {
            return false; // End input cleanly if the user closes the console input.
        }

        istringstream input(line);
        int value;
        string extraText;

        if (!(input >> value) || (input >> extraText) ||
            value < minimum || value > maximum) {
            cout << errorMessage << '\n';
            continue;
        }

        result = value;
        return true;
    }
}

void displayMenu() {
    cout << "\n=== Factorial and Series Calculator ===\n"
         << "1 - Factorial n!\n"
         << "2 - Sum 1 + 2 + ... + n\n"
         << "3 - Sum of squares 1^2 + ... + n^2\n"
         << "4 - Compare factorial and sum\n"
         << "0 - Exit\n";
}

int main() {
    int option;
while (true) {
        displayMenu();
        if (!readIntegerInRange("Choose an option: ", 0, 4,
                                "Invalid option. Enter a whole number from 0 to 4.",
                                option)) {
            cout << "\nInput ended. Exiting.\n";
            break;
        }

        if (option == 0) {
            cout << "Goodbye!\n";
            break;
        }

        int n;
        if (!readIntegerInRange("Enter n (0 to 12): ", 0, 12,
                                "Invalid number; enter a whole number from 0 to 12 and try again.",
                                n)) {
            cout << "\nInput ended. Exiting.\n";
            break;
        }

        switch (option) {
            case 1:
                cout << "Factorial = " << factorial(n) << '\n';
                break;
            case 2:
                cout << "Sum = " << sumNatural(n) << '\n';
                break;
            case 3:
                cout << "Squares sum = " << sumSquares(n) << '\n';
                break;
            case 4:
                compareResults(n);
                break;
        }
    }

    return 0;
}
